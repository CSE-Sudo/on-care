# AWS App Runner 운영 환경변수 템플릿 (#2821)
# ─────────────────────────────────────────────────────────────────────────
# 사용법: App Runner 서비스 > 구성 > 환경 변수에 아래 키를 넣는다. 민감값(JWT_SECRET,
# DATABASE_URL, API 키)은 일반 변수가 아니라 Secrets Manager·SSM 참조로 넣는다.
#   · 이 파일은 키 이름과 형식만 적은 예시다. 실제 값은 커밋하지 않는다.
#   · 운영 서비스와 데모 시연 서비스는 **서로 다른 DB** 를 쓴다(아래 DATABASE_URL 참고).
#   · 배포 워크플로(.github/workflows/backend-deploy.yml)가 배포 직후 /v1/healthz 로
#     env=prod·demo_fallback=false·demo_seed=false·attachment_storage=s3 를, /v1/version 으로
#     commit_sha 가 배포한 커밋인지 확인하고 아니면 실패한다(#3029).
#   · 체크리스트: backend/docs/DEPLOY.md 의 "운영 체크리스트".
#   · 활성 줄(KEY=값)은 운영에서 값을 넣거나 확인할 키, 주석 줄(# KEY=값)은 기본값을 쓰되
#     있다는 것을 알아야 하는 키다(바꿀 때만 주석을 푼다). 여기 없는 설정 키는 기본값이
#     운영값이라 일부러 뺐다 — 사유는 tests/test_env_aws_example.py 에 있다(#3034).

# 반드시 prod. 비우면 컨테이너가 뜨지 않는다(scripts/start.sh).
ENV=prod

# 운영 전용 DB(Neon 등). 데모 시드가 들어간 DB 를 가리키면 안 된다.
# 형식: postgresql://<user>:<password>@<host>/<db>?sslmode=require  (풀러가 아닌 직접 엔드포인트)
DATABASE_URL=

# 운영은 Alembic 이 스키마의 정답 → 앱 기동 시 create_all() 비활성(true 면 기동 거부).
AUTO_CREATE_TABLES=false

# openssl rand -hex 32  (기본값이거나 32바이트 미만이면 기동 거부, #3029)
JWT_SECRET=

# 프론트 배포 도메인(콤마 구분). 와일드카드('*')·비워 둠(개발 기본값 localhost 목록)·
# localhost·127.0.0.1·http:// 출처는 기동 거부(#3029).
# 형식: https://<회원 앱 도메인>,https://<트레이너 웹 도메인>
CORS_ALLOW_ORIGINS=

# 운영은 데모 시드·데모 폴백을 끈다. 데모 시연은 별도 서비스(ENV=staging)·별도 DB 로 띄운다.
SEED_DEMO_DATA=false
ALLOW_DEMO_FALLBACK=false
# 데모 계정 로그인 비밀번호 — 데모 시드를 켠 시연 서비스 전용. 운영에서는 넣지 않는다.
# DEMO_LOGIN_PASSWORD=

TZ=Asia/Seoul
FORCE_HTTPS=true
LOG_LEVEL=INFO

# 채팅 첨부 저장소(#2817). 운영은 S3 만 허용한다 — 버킷이 비어 컨테이너 디스크로 풀리면
# 재배포 때 사진·PDF 가 사라지므로 기동을 거부한다(#3029).
# 자격 증명은 App Runner 인스턴스 역할로 준다(키를 넣지 않는다).
ATTACHMENT_STORAGE=s3
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_PREFIX=chat-attachments
# S3 호환 저장소(MinIO 등)를 쓸 때만. AWS S3 는 비워 둔다.
# ATTACHMENT_S3_ENDPOINT_URL=

# AI — 운영은 사진 인식·임베딩 키가 필수다. 키가 없거나 RECOGNIZER=stub·EMBEDDER=hash 면
# 기동을 거부한다(#2812).
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
GEMINI_API_KEY=
# 운영은 별칭(gemini-flash-latest) 대신 고정 버전을 넣는다 — DEPLOY.md "모델 고정".
# 형식: gemini-<버전>-flash 등 제공자가 공개한 고정 모델 이름
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
# 식단 사진 인식 타임아웃(초). 사진 분석은 글보다 오래 걸려 따로 둔다.
RECOGNIZER_TIMEOUT_SECONDS=60
EMBED_DIM=768

# 장소(O2O) 실검색(#2914). 운영은 키가 없으면 헬스장 찾기가 사실상 빈다 — DB 장소에서
# 데모 시드 장소를 빼고 읽는다. 키가 있어도 카카오 0건이면 빈 목록, 실패면 503 이고 시드로
# 채우지 않는다. PLACES_PROVIDER 는 auto(키가 있으면 카카오)로 둔다.
KAKAO_REST_API_KEY=
PLACES_PROVIDER=auto

# Apple 로그인 aud 목록(콤마 구분). 비우면 Apple 로그인 거부.
APPLE_CLIENT_IDS=

# 쓰지 않는다(#3037) — 비워 둔다. 관리자 지정은 scripts/grant_admin.py (docs/DEPLOY.md).
ADMIN_EMAILS=

# 메일 발송·비밀번호 재설정(#2824·#3033). 운영에서 SMTP 서버와 발신 주소가 없으면 재설정
# 요청이 503 으로 꺼진다 — 기동은 되므로 배포 검증으로는 드러나지 않는다. 운영은 auto 대신
# smtp 로 명시한다(서버·발신 주소가 비면 기동이 거부돼 빠뜨린 것이 바로 드러난다).
# 업체·SES 구성·자격 증명 발급은 #480. SMTP_PASSWORD 는 Secrets Manager·SSM 참조로 넣는다.
MAIL_PROVIDER=smtp
# 발신 주소. 형식: OnCare <no-reply@<운영 도메인>>  또는  no-reply@<운영 도메인>
MAIL_FROM=
# 형식: email-smtp.<리전>.amazonaws.com (SES) 등 업체의 SMTP 엔드포인트
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 은 STARTTLS, 465 는 SMTP_SSL=true·SMTP_STARTTLS=false.
SMTP_STARTTLS=true
SMTP_SSL=false
# SMTP 연결·응답 대기 상한(초).
# SMTP_TIMEOUT_SECONDS=10
# 메일 링크가 여는 재설정 화면. 두 앱은 해시 URL 전략·하위 경로 배포라 해시형으로 넣는다 —
# 서버가 …#/auth/password-reset?token=… 꼴로 토큰을 붙인다. 해시 없는 경로형은 앱이 아닌
# 정적 경로를 가리켜 코드가 버려진다(형식이 틀리면 기동 경고). 비우면 메일에 코드만 보낸다.
# 형식: https://<운영 도메인>/frontend/#/auth/password-reset
PASSWORD_RESET_MEMBER_URL=
# 형식: https://<운영 도메인>/trainer/#/auth/password-reset
PASSWORD_RESET_TRAINER_URL=
# 재설정 코드 유효 시간(분)·같은 이메일 재발송 한도(횟수/창 분).
# PASSWORD_RESET_TOKEN_MINUTES=30
# PASSWORD_RESET_EMAIL_PER_WINDOW=3
# PASSWORD_RESET_EMAIL_WINDOW_MINUTES=15

# 에러 추적(#2839). 비우면 운영 오류가 어디에도 모이지 않는다. 값은 #480 에서 채운다.
SENTRY_DSN=
# 비우면 ENV 값. 샘플링 비율 0~1.
# SENTRY_ENVIRONMENT=
# SENTRY_SAMPLE_RATE=1.0

# 프록시·클라이언트 IP(#2815). rate limit·감사 로그가 믿는 앞단 프록시 수 — App Runner 는 1.
# 프록시가 둘 이상 붙으면 그 수로 맞춘다.
TRUSTED_PROXY_HOPS=1
# uvicorn 프록시 헤더 신뢰 대역(scripts/start.sh). 고정 대역이 있으면 좁힌다.
# FORWARDED_ALLOW_IPS=*

# 워커·DB 풀(#2835·#2836). (DB_POOL_SIZE + DB_MAX_OVERFLOW) × WEB_CONCURRENCY × 인스턴스 수가
# Neon 연결 상한 안에 들어와야 한다(DEPLOY.md "DB 커넥션 풀"). 워커를 늘리면 시도 제한도
# 워커 수만큼 늘어난다.
# WEB_CONCURRENCY=1
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=300
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_CONNECT_TIMEOUT_SECONDS=5

# 토큰 수명(#2913·#2828). 데모 서비스에서 길게 바꾼 값이 운영으로 복사되지 않게 운영 값을 둔다.
# 접근 토큰(분)·모바일 refresh(일)·웹 refresh(일).
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
WEB_REFRESH_TOKEN_EXPIRE_DAYS=7

# 기능 스위치. 제휴 헬스장이 생기기 전까지 혜택은 닫아 둔다(#2822). 운영 API 문서는 닫는다(#2834).
GYM_BENEFITS_ENABLED=false
EXPOSE_API_DOCS=false

# 하드닝 — 운영은 기본값(true) 유지. 끄면 보안 헤더·시도 제한이 빠진다.
SECURITY_HEADERS=true
RATE_LIMIT_ENABLED=true

# 감사 로그 보존(일, #2830). 처리방침 보관 기간(일반 1년·민감 2년, docs/privacy_processing.md)과
# 묶인 값이라 처리방침과 함께 바꾼다.
AUDIT_RETENTION_DAYS=365
AUDIT_SENSITIVE_RETENTION_DAYS=730

# 마이그레이션 잠금 대기 한도(초)·잠금 재시도 간격(초)·DB 연결 한도(초). scripts/migrate.py
MIGRATE_LOCK_TIMEOUT=120
MIGRATE_LOCK_RETRY_INTERVAL=2
MIGRATE_CONNECT_TIMEOUT=10

# 참고: PORT 는 넣지 않는다(start.sh 가 ${PORT:-8000}).
# 참고: GIT_SHA 는 넣지 않는다 — 배포 워크플로가 이미지 빌드 인자로 넣는다(#3029).
