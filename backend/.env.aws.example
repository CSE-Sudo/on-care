# AWS 운영(ECS Express Mode) 환경변수 목록 (#2821, #3016)
# ─────────────────────────────────────────────────────────────────────────
# 실제 값의 원본은 이 파일이 아니라 서비스 스택 템플릿(infra/backend-service.yml)과 그 스택
# 파라미터, 그리고 Secrets Manager 비밀 oncare/backend/<environment>(JSON) 이다.
# 이 파일은 운영 서비스에 어떤 키가 어떤 값으로 들어가는지 한눈에 보는 목록이다.
#   · 키 목록은 템플릿과 같다 — backend/tests/test_deploy_template.py 가 둘을 맞춘다.
#   · [비밀] 표시 키는 비밀 JSON 의 같은 이름 키로 넣는다. 평문 환경변수로 넣지 않는다.
#     쓰지 않는 키(예: SENTRY_DSN)도 빈 문자열로 키는 만들어 둔다 — 없는 키를 참조하면
#     태스크가 뜨지 않는다.
#   · [파라미터] 표시 키는 서비스 스택 파라미터로 정한다(콘솔에서 서비스를 직접 고치면
#     다음 배포가 템플릿 값으로 되돌린다).
#   · 운영 서비스와 데모 시연(staging) 서비스는 **서로 다른 DB** 를 쓴다.
#   · 배포 워크플로가 배포 직후 /v1/healthz 로 env=prod·demo_fallback=false·
#     demo_seed=false·attachment_storage=s3 를, /v1/version 으로 commit_sha 가 배포한
#     커밋인지 확인하고(#3029), 아니면 직전 이미지로 되돌린다.
#   · 절차·체크리스트: backend/docs/DEPLOY.md

# 반드시 prod(staging 스택은 staging). 비우면 컨테이너가 뜨지 않는다(scripts/start.sh).
ENV=prod

# [비밀] 운영 전용 DB(Neon 등). 데모 시드가 들어간 DB 를 가리키면 안 된다.
# 형식: postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require  (풀러가 아닌 직접 엔드포인트)
DATABASE_URL=

# 운영은 Alembic 이 스키마의 정답 → 앱 기동 시 create_all() 비활성(true 면 기동 거부).
AUTO_CREATE_TABLES=false

# [비밀] openssl rand -hex 32  (기본값이거나 32바이트 미만이면 기동 거부, #3029)
JWT_SECRET=

# [파라미터 CorsAllowOrigins] 프론트 배포 도메인(콤마 구분). 와일드카드('*')·비워 둠(개발
# 기본값 localhost 목록)·localhost·127.0.0.1·http:// 출처는 기동 거부(#3029).
# 형식: https://<회원 앱 도메인>,https://<트레이너 웹 도메인>
CORS_ALLOW_ORIGINS=

# 운영은 데모 시드·데모 폴백을 끈다(템플릿이 환경 이름으로 정한다). staging 은 시드를 켠다.
SEED_DEMO_DATA=false
ALLOW_DEMO_FALLBACK=false

TZ=Asia/Seoul
FORCE_HTTPS=true
LOG_LEVEL=INFO

# 로드 밸런서(ALB) 하나 뒤다 — X-Forwarded-For 를 오른쪽에서 첫 값으로 읽는다(#2815).
TRUSTED_PROXY_HOPS=1
# 워커·태스크 하나. 시도 제한·메트릭이 프로세스 메모리에 있다(#2835).
WEB_CONCURRENCY=1

# 채팅 첨부 저장소(#2817). 운영은 S3 만 허용한다 — 버킷이 비어 컨테이너 디스크로 풀리면
# 재배포 때 사진·PDF 가 사라지므로 기동을 거부한다(#3029).
# 버킷은 환경 스택(infra/backend-environment.yml)이 만들고, 자격 증명은 태스크 역할로
# 준다(키를 넣지 않는다). 리전은 서비스 리전과 같다.
ATTACHMENT_STORAGE=s3
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_PREFIX=chat-attachments

# AI — 키가 없으면 규칙·stub 폴백으로 기동은 된다.
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
# [비밀]
GEMINI_API_KEY=
# [파라미터 GeminiModel] 운영은 별칭(gemini-flash-latest) 대신 고정 버전 — DEPLOY.md "모델 고정".
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
# 식단 사진 인식 타임아웃(초). 사진 분석은 글보다 오래 걸려 따로 둔다.
RECOGNIZER_TIMEOUT_SECONDS=60
EMBED_DIM=768

# [비밀] 장소(O2O) 실검색 — 빈 값이면 시드 폴백.
KAKAO_REST_API_KEY=

# [비밀] 오류 수집. 빈 값이면 꺼진다.
SENTRY_DSN=

# [파라미터 AppleClientIds] Apple 로그인 aud 목록(콤마 구분). 비우면 Apple 로그인 거부.
APPLE_CLIENT_IDS=

# [파라미터 AdminEmails] 관리자 이메일(콤마 구분) — 기동 시 is_admin 승격.
ADMIN_EMAILS=

# 비밀번호 재설정 메일(#2824). [파라미터 MailFrom] 을 비우면 아래 메일 키는 넣지 않고,
# 재설정 요청은 503 으로 꺼진다. 채우면 SMTP_USERNAME·SMTP_PASSWORD 를 비밀에 넣는다.
MAIL_PROVIDER=smtp
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# [비밀]
SMTP_USERNAME=
# [비밀]
SMTP_PASSWORD=
# [파라미터] 메일 속 링크가 여는 화면. 비우면 링크 없이 코드만 보낸다.
PASSWORD_RESET_MEMBER_URL=
PASSWORD_RESET_TRAINER_URL=

# 마이그레이션 대기 한도(초)·DB 연결 한도(초). scripts/migrate.py
MIGRATE_LOCK_TIMEOUT=120
MIGRATE_CONNECT_TIMEOUT=10

# 참고: PORT 는 넣지 않는다(start.sh 가 ${PORT:-8000}, 컨테이너 포트 8000).
# 참고: GIT_SHA 는 넣지 않는다 — 배포 워크플로가 이미지 빌드 인자로 넣는다(#3029).
