# AWS App Runner 운영 환경변수 템플릿 (#2821)
# ─────────────────────────────────────────────────────────────────────────
# 사용법: App Runner 서비스 > 구성 > 환경 변수에 아래 키를 넣는다. 민감값(JWT_SECRET,
# DATABASE_URL, API 키)은 일반 변수가 아니라 Secrets Manager·SSM 참조로 넣는다.
#   · 이 파일은 키 이름과 형식만 적은 예시다. 실제 값은 커밋하지 않는다.
#   · 운영 서비스와 데모 시연 서비스는 **서로 다른 DB** 를 쓴다(아래 DATABASE_URL 참고).
#   · 배포 워크플로(.github/workflows/backend-deploy.yml)가 배포 직후 /v1/healthz 로
#     env=prod·demo_fallback=false·demo_seed=false 를 확인하고 아니면 실패한다.
#   · 체크리스트: backend/docs/DEPLOY.md 의 "운영 체크리스트".

# 반드시 prod. 비우면 컨테이너가 뜨지 않는다(scripts/start.sh).
ENV=prod

# 운영 전용 DB(Neon 등). 데모 시드가 들어간 DB 를 가리키면 안 된다.
# 형식: postgresql://<user>:<password>@<host>/<db>?sslmode=require  (풀러가 아닌 직접 엔드포인트)
DATABASE_URL=

# 운영은 Alembic 이 스키마의 정답 → 앱 기동 시 create_all() 비활성(true 면 기동 거부).
AUTO_CREATE_TABLES=false

# openssl rand -hex 32  (기본값이면 기동 거부)
JWT_SECRET=

# 프론트 배포 도메인(콤마 구분). 와일드카드('*') 금지.
# 형식: https://<회원 앱 도메인>,https://<트레이너 웹 도메인>
CORS_ALLOW_ORIGINS=

# 운영은 데모 시드·데모 폴백을 끈다. 데모 시연은 별도 서비스(ENV=staging)·별도 DB 로 띄운다.
SEED_DEMO_DATA=false
ALLOW_DEMO_FALLBACK=false

TZ=Asia/Seoul
FORCE_HTTPS=true
LOG_LEVEL=INFO

# 채팅 첨부 저장소(#2817). 비우면 컨테이너 디스크라 재배포 때 사진·PDF 가 사라진다.
# 자격 증명은 App Runner 인스턴스 역할로 준다(키를 넣지 않는다).
ATTACHMENT_STORAGE=s3
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_PREFIX=chat-attachments

# AI — 키가 없으면 규칙·stub 폴백으로 기동은 된다.
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
GEMINI_API_KEY=
# 운영은 별칭(gemini-flash-latest) 대신 고정 버전을 넣는다 — DEPLOY.md "모델 고정".
# 형식: gemini-<버전>-flash 등 제공자가 공개한 고정 모델 이름
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
# 식단 사진 인식 타임아웃(초). 사진 분석은 글보다 오래 걸려 따로 둔다.
RECOGNIZER_TIMEOUT_SECONDS=60
EMBED_DIM=768

# 장소(O2O) 실검색 — 없으면 시드 폴백.
KAKAO_REST_API_KEY=

# Apple 로그인 aud 목록(콤마 구분). 비우면 Apple 로그인 거부.
APPLE_CLIENT_IDS=

# 쓰지 않는다(#3037) — 비워 둔다. 관리자 지정은 scripts/grant_admin.py (docs/DEPLOY.md).
ADMIN_EMAILS=

# 마이그레이션 대기 한도(초)·DB 연결 한도(초). scripts/migrate.py
MIGRATE_LOCK_TIMEOUT=120
MIGRATE_CONNECT_TIMEOUT=10

# 참고: PORT 는 넣지 않는다(start.sh 가 ${PORT:-8000}).
