# AWS 운영(ECS Express Mode) 환경변수 목록 (#2821, #3016)
# ─────────────────────────────────────────────────────────────────────────
# 실제 값의 원본은 이 파일이 아니라 서비스 스택 템플릿(infra/backend-service.yml)과 그 스택
# 파라미터, 그리고 Secrets Manager 비밀 oncare/backend/<environment>(JSON) 이다.
# 이 파일은 운영 서비스에 어떤 키가 어떤 값으로 들어가는지 한눈에 보는 목록이다.
#   · 활성 줄(KEY=값)의 키 목록은 템플릿과 같다 — backend/tests/test_deploy_template.py 가 둘을
#     맞춘다. 주석 줄(# KEY=값)은 기본값을 쓰되 있다는 것을 알아야 하는 키다(바꿀 때는 템플릿에
#     키를 더하고 주석을 푼다). 여기 없는 설정 키는 기본값이 운영값이라 일부러 뺐다 — 사유는
#     tests/test_env_aws_example.py 에 있다(#3034).
#   · [비밀] 표시 키는 비밀 JSON 의 같은 이름 키로 넣는다. 평문 환경변수로 넣지 않는다.
#     쓰지 않는 키(예: SENTRY_DSN)도 빈 문자열로 키는 만들어 둔다 — 없는 키를 참조하면
#     태스크가 뜨지 않는다.
#   · [파라미터] 표시 키는 서비스 스택 파라미터로 정한다(콘솔에서 서비스를 직접 고치면
#     다음 배포가 템플릿 값으로 되돌린다).
#   · 운영 서비스와 데모 시연(staging) 서비스는 **서로 다른 DB** 를 쓴다.
#   · 배포 워크플로가 배포 직후 /v1/healthz 로 env=prod·demo_fallback=false·
#     demo_seed=false·attachment_storage=s3 를, /v1/version 으로 commit_sha 가 배포한
#     커밋인지 확인하고(#3029), 아니면 직전 이미지로 되돌린다.
#   · 절차·체크리스트: backend/docs/DEPLOY.md

# 반드시 prod(staging 스택은 staging). 비우면 컨테이너가 뜨지 않는다(scripts/start.sh).
ENV=prod

# [비밀] 운영 전용 DB(Neon 등). 데모 시드가 들어간 DB 를 가리키면 안 된다.
# 형식: postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require  (풀러가 아닌 직접 엔드포인트)
DATABASE_URL=

# 운영은 Alembic 이 스키마의 정답 → 앱 기동 시 create_all() 비활성(true 면 기동 거부).
AUTO_CREATE_TABLES=false

# [비밀] openssl rand -hex 32  (기본값이거나 32바이트 미만이면 기동 거부, #3029)
JWT_SECRET=

# [파라미터 CorsAllowOrigins] 프론트 배포 도메인(콤마 구분). 와일드카드('*')·비워 둠(개발
# 기본값 localhost 목록)·localhost·127.0.0.1·http:// 출처는 기동 거부(#3029).
# 형식: https://<회원 앱 도메인>,https://<트레이너 웹 도메인>
CORS_ALLOW_ORIGINS=

# 운영은 데모 시드·데모 폴백을 끈다(템플릿이 환경 이름으로 정한다). staging 은 시드를 켠다.
SEED_DEMO_DATA=false
ALLOW_DEMO_FALLBACK=false
# [비밀] 데모 계정 로그인 비밀번호 — staging 스택만 읽는다. 운영 비밀에는 넣지 않는다.
# DEMO_LOGIN_PASSWORD=

TZ=Asia/Seoul
FORCE_HTTPS=true
LOG_LEVEL=INFO

# 프록시·클라이언트 IP(#2815). 로드 밸런서(ALB) 하나 뒤다 — X-Forwarded-For 를 오른쪽에서
# 첫 값으로 읽는다. 프록시가 둘 이상 붙으면 그 수로 맞춘다.
TRUSTED_PROXY_HOPS=1
# uvicorn 프록시 헤더 신뢰 대역(scripts/start.sh). 고정 대역이 있으면 좁힌다.
# FORWARDED_ALLOW_IPS=*

# 워커·태스크 하나. 시도 제한·메트릭이 프로세스 메모리에 있다(#2835).
WEB_CONCURRENCY=1
# DB 풀(#2836). (DB_POOL_SIZE + DB_MAX_OVERFLOW) × WEB_CONCURRENCY × 태스크 수가 Neon 연결 상한
# 안에 들어와야 한다(DEPLOY.md "DB 커넥션 풀").
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=300
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_CONNECT_TIMEOUT_SECONDS=5

# 채팅 첨부 저장소(#2817). 운영은 S3 만 허용한다 — 버킷이 비어 컨테이너 디스크로 풀리면
# 재배포 때 사진·PDF 가 사라지므로 기동을 거부한다(#3029).
# 버킷은 환경 스택(infra/backend-environment.yml)이 만들고, 자격 증명은 태스크 역할로
# 준다(키를 넣지 않는다). 리전은 서비스 리전과 같다.
ATTACHMENT_STORAGE=s3
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_PREFIX=chat-attachments
# S3 호환 저장소(MinIO 등)를 쓸 때만. AWS S3 는 비워 둔다.
# ATTACHMENT_S3_ENDPOINT_URL=

# AI — 운영은 사진 인식·임베딩 키가 필수다. 키가 없거나 RECOGNIZER=stub·EMBEDDER=hash 면
# 기동을 거부한다(#2812).
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
# [비밀]
# 반드시 **결제가 연결된 프로젝트의 키(유료 등급)** 를 넣는다(#3032). 무료 등급은 입력
# (회원 음식 사진·건강 기록·코치 대화)이 제공자의 서비스 개선에 쓰일 수 있고, 분당·일일
# 한도가 낮아 첫날부터 사진 분석·코치가 폴백·오류로 떨어진다. 결제 연결은 #480.
GEMINI_API_KEY=
# [파라미터 GeminiModel] 운영은 별칭(gemini-flash-latest) 대신 고정 버전 — DEPLOY.md "모델 고정".
# 형식: gemini-<버전>-flash 등 제공자가 공개한 고정 모델 이름
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
# 식단 사진 인식 타임아웃(초). 사진 분석은 글보다 오래 걸려 따로 둔다.
RECOGNIZER_TIMEOUT_SECONDS=60
EMBED_DIM=768
# 비용 상한(#3032). 회원 한도(코치·사진 분석)는 한 회원만 묶어, 가입자 수만큼 비용이
# 열린다. 아래 둘은 DB 에서 KST 날짜로 센다(인스턴스·재기동과 무관). 0 이면 끔.
# - AI_GLOBAL_CALLS_PER_DAY: 서버 전체 하루 AI 호출 합. 공급자 콘솔 예산을 하루 호출
#   수로 나눠 정한다(호출당 비용 × 이 값 ≤ 하루 예산). 넘으면 규칙형 폴백이 있는 기능은
#   폴백, AI 코치 채팅·사진 분석은 503 ai_capacity.
# - TRAINER_AI_CALLS_PER_DAY: 트레이너 한 계정의 하루 AI 호출(코치·루틴 후보·리포트 요약).
# - LLM_MAX_OUTPUT_TOKENS: 호출 한 번의 출력 토큰 천장.
# 0 은 "끔" 이다. 출시 전에 #480 의 예산으로 정한 값으로 바꾼다(빈 값은 기동 실패).
AI_GLOBAL_CALLS_PER_DAY=0
TRAINER_AI_CALLS_PER_DAY=200
LLM_MAX_OUTPUT_TOKENS=4096

# [비밀] 장소(O2O) 실검색(#2914). 운영은 키가 없으면 헬스장 찾기가 사실상 빈다 — DB 장소에서
# 데모 시드 장소를 빼고 읽는다. 키가 있어도 카카오 0건이면 빈 목록, 실패면 503 이고 시드로
# 채우지 않는다. PLACES_PROVIDER 는 auto(키가 있으면 카카오)로 둔다.
KAKAO_REST_API_KEY=
PLACES_PROVIDER=auto

# [파라미터 AppleClientIds] Apple 로그인 aud 목록(콤마 구분). 비우면 Apple 로그인 거부.
APPLE_CLIENT_IDS=
# [파라미터 GoogleClientIds] Google 로그인 aud(client_id) 목록(콤마 구분, iOS·Android·웹). 비우면 Google 로그인 거부(#3035).
GOOGLE_CLIENT_IDS=
# [파라미터 KakaoAppId] 카카오 앱 ID(콘솔 > 앱 설정의 숫자 앱 ID, REST 키 아님). 비우면 카카오 로그인 거부(#3035).
KAKAO_APP_ID=

# [파라미터 AdminEmails] 쓰지 않는다(#3037) — 비워 둔다. 관리자 지정은 scripts/grant_admin.py (docs/DEPLOY.md).
# 값이 남아 있으면 기동 로그에 경고만 하고 아무도 올리지 않는다. 템플릿 파라미터 정리는 #480.
ADMIN_EMAILS=

# 메일 발송·비밀번호 재설정(#2824·#3033). [파라미터 MailFrom] 을 비우면 아래 메일 키는 넣지
# 않고 재설정 요청은 503 으로 꺼진다. 채우면 MAIL_PROVIDER=smtp 로 들어가 SMTP 서버·발신 주소가
# 비었을 때 기동이 거부돼 빠뜨린 것이 바로 드러난다. 업체·SES 구성·자격 증명 발급은 #480.
MAIL_PROVIDER=smtp
# [파라미터 MailFrom] 형식: OnCare <no-reply@<운영 도메인>>  또는  no-reply@<운영 도메인>
MAIL_FROM=
# [파라미터 SmtpHost] 형식: email-smtp.<리전>.amazonaws.com (SES) 등 업체의 SMTP 엔드포인트
SMTP_HOST=
# [파라미터 SmtpPort]
SMTP_PORT=587
# [비밀]
SMTP_USERNAME=
# [비밀]
SMTP_PASSWORD=
# 587 은 STARTTLS, 465 는 SMTP_SSL=true·SMTP_STARTTLS=false(템플릿은 587 기준).
SMTP_STARTTLS=true
SMTP_SSL=false
# SMTP 연결·응답 대기 상한(초).
# SMTP_TIMEOUT_SECONDS=10
# [파라미터] 메일 링크가 여는 재설정 화면. 두 앱은 해시 URL 전략·하위 경로 배포라 해시형으로
# 넣는다 — 서버가 …#/auth/password-reset?token=… 꼴로 토큰을 붙인다. 해시 없는 경로형은 앱이
# 아닌 정적 경로를 가리켜 코드가 버려진다(형식이 틀리면 기동 경고). 비우면 메일에 코드만 보낸다.
# 형식: https://<운영 도메인>/frontend/#/auth/password-reset
PASSWORD_RESET_MEMBER_URL=
# 형식: https://<운영 도메인>/trainer/#/auth/password-reset
PASSWORD_RESET_TRAINER_URL=
# 재설정 코드 유효 시간(분)·같은 이메일 재발송 한도(횟수/창 분).
# PASSWORD_RESET_TOKEN_MINUTES=30
# PASSWORD_RESET_EMAIL_PER_WINDOW=3
# PASSWORD_RESET_EMAIL_WINDOW_MINUTES=15
# 가입·이메일 변경 안내 메일 끝의 문의처(#3038·#3039, 결정 필요). 비우면 문의처 줄이 빠진다.
# MAIL_SUPPORT_CONTACT=
# 가입 이메일 인증(#3038). 운영은 끌 수 없다 — false 면 기동 거부. 코드 유효 시간(분)·
# 재요청 간격(초)·코드당 틀린 횟수·같은 이메일 요청 한도(횟수/창 분). 기본값이 운영값이다.
# SIGNUP_EMAIL_VERIFICATION=true
# SIGNUP_EMAIL_CODE_MINUTES=10
# SIGNUP_EMAIL_CODE_RESEND_SECONDS=60
# SIGNUP_EMAIL_CODE_MAX_ATTEMPTS=5
# SIGNUP_EMAIL_CODE_PER_WINDOW=5
# SIGNUP_EMAIL_CODE_WINDOW_MINUTES=60

# [비밀] 에러 추적(#2839). 빈 값이면 운영 오류가 어디에도 모이지 않는다. 값은 #480 에서 채운다.
SENTRY_DSN=
# 비우면 ENV 값. 샘플링 비율 0~1.
# SENTRY_ENVIRONMENT=
# SENTRY_SAMPLE_RATE=1.0

# 토큰 수명(#2913·#2828). 데모 서비스에서 길게 바꾼 값이 운영으로 복사되지 않게 운영 값을 둔다.
# 접근 토큰(분)·모바일 refresh(일)·웹 refresh(일).
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
WEB_REFRESH_TOKEN_EXPIRE_DAYS=7

# 기능 스위치. 제휴 헬스장이 생기기 전까지 혜택은 닫아 둔다(#2822). 운영 API 문서는 닫는다(#2834).
GYM_BENEFITS_ENABLED=false
EXPOSE_API_DOCS=false

# 하드닝 — 운영은 기본값(true) 유지. 끄면 보안 헤더·시도 제한이 빠진다.
SECURITY_HEADERS=true
RATE_LIMIT_ENABLED=true

# 감사 로그 보존(일, #2830). 처리방침 보관 기간(일반 1년·민감 2년, docs/privacy_processing.md)과
# 묶인 값이라 처리방침과 함께 바꾼다.
AUDIT_RETENTION_DAYS=365
AUDIT_SENSITIVE_RETENTION_DAYS=730

# 마이그레이션 잠금 대기 한도(초)·잠금 재시도 간격(초)·DB 연결 한도(초). scripts/migrate.py
MIGRATE_LOCK_TIMEOUT=120
MIGRATE_LOCK_RETRY_INTERVAL=2
MIGRATE_CONNECT_TIMEOUT=10

# 참고: PORT 는 넣지 않는다(start.sh 가 ${PORT:-8000}, 컨테이너 포트 8000).
# 참고: GIT_SHA 는 넣지 않는다 — 배포 워크플로가 이미지 빌드 인자로 넣는다(#3029).
