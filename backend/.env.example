# cp .env.example .env 후 값 채우기
# 환경: dev | staging | prod   (prod 는 아래 JWT_SECRET 기본값이면 기동이 차단됨)
ENV=dev

DATABASE_URL=postgresql+psycopg://oncare:oncare@localhost:5432/oncare
# 앱 기동 시 create_all() 로 테이블 생성(개발 편의). 운영은 Alembic 사용 → false 권장.
AUTO_CREATE_TABLES=true

# 운영에서는 반드시 교체:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ALGORITHM=HS256
# 접근 토큰 수명(분, #2913). 앱은 만료되면 refresh 로 이어 간다. 데모·개발은 길게 둬도 된다.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- 클라이언트 IP·시도 제한 (#2815) ---
# rate limit·감사 로그가 믿는 앞단 프록시 수. X-Forwarded-For 를 오른쪽에서 이 번째 값으로
# 읽는다. 비워 두면 운영(ENV=prod)은 1, 그 밖은 0(소켓 주소). 로컬은 비워 둔다.
TRUSTED_PROXY_HOPS=
# uvicorn --forwarded-allow-ips(scripts/start.sh). 프록시 대역이 고정이면 그 대역으로 좁힌다.
FORWARDED_ALLOW_IPS=*
# 같은 이메일 로그인 연속 실패 잠금: LOGIN_LOCKOUT_SECONDS 안에 LOGIN_MAX_FAILURES 번.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# 같은 이메일 가입 시도 시간당 상한(회원·트레이너 공용, #2913).
REGISTER_PER_EMAIL_PER_HOUR=5
# 비밀번호 변경의 현재 비밀번호 연속 실패 잠금(사용자 단위, 창은 LOGIN_LOCKOUT_SECONDS, #2913).
PASSWORD_CHANGE_MAX_FAILURES=5

# --- API 문서 공개 (#2834) ---
# /docs·/redoc·/openapi.json. 비워 두면 운영(ENV=prod)은 닫고 그 밖은 연다.
# 운영 스키마는 스테이징·로컬에서 본다. 꼭 운영에서 열어야 할 때만 true.
EXPOSE_API_DOCS=
# 회원 연결 코드 미리보기·사용의 트레이너 하루 상한.
PAIRING_REDEEM_PER_DAY=30
# AI (이후 STEP)
RECOGNIZER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# 참조표에 바로 붙지 않는 운동 이름을 AI 로 종목에 접는다(#1312). 끄면 표 매칭만
# 쓰고, 안 붙는 이름은 유형 평균으로 떨어진다. 키가 없으면 이 값과 무관하게 폴백.
EXERCISE_NAME_AI=true
COACH_LLM=gemini
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
EMBEDDER=gemini
OPENAI_EMBED_MODEL=text-embedding-3-small
# --- 카카오 Local 장소검색 (#255) ---
# developers.kakao.com > 내 애플리케이션 > 앱 키 > "REST API 키"를 붙여넣는다.
# 서버 전용 키 — 프론트로 내보내지 말 것(지도 렌더링은 JavaScript 키를 따로 쓴다).
# 비워두면 places_provider=auto 가 시드 데이터로 폴백한다.
KAKAO_REST_API_KEY=
# auto: 키 있으면 kakao, 없으면 seed. 강제하려면 kakao|seed.
PLACES_PROVIDER=auto
KAKAO_TIMEOUT_SECONDS=3.0

# --- 소셜 로그인 ---
# Apple 로그인에서 허용할 aud(client_id) 목록, 콤마 구분.
# iOS 앱은 번들 ID, 웹은 Service ID 로 서로 다른 aud 를 받으므로 복수를 넣는다.
#   예: APPLE_CLIENT_IDS=com.oncare.app,com.oncare.web
# 비워두면 Apple 로그인은 검증할 수 없어 **거부**된다(조용히 통과시키면 다른 앱용
# Apple 토큰으로도 로그인이 뚫린다). kakao/google 은 별도 설정이 필요 없다.
APPLE_CLIENT_IDS=

# 기타
# 로그 타임스탬프용. 도메인 날짜(오늘 식단·오늘/어제 라벨 등)는 이 값에 기대지 않고
# app/core/clock.py 가 KST 로 직접 고정하므로, 비워 둬도 서비스 동작은 같다.
TZ=Asia/Seoul
CORS_ALLOW_ORIGINS=*
# 운영은 false 권장. true로 켜면 DEMO_LOGIN_PASSWORD를 12자 이상으로 반드시 설정.
SEED_DEMO_DATA=true
DEMO_LOGIN_PASSWORD=oncare123

# --- RAG (STEP 7) ---
# 임베딩 차원은 EMBEDDER 모델에 맞춤: Gemini gemini-embedding-001=768 · OpenAI text-embedding-3-small=1536
EMBED_DIM=768
CHUNK_WINDOW=5
CHUNK_OVERLAP=1
RETRIEVE_PERSONAL_K=3
RETRIEVE_PUBLIC_K=3

# --- LiteLLM 프록시 (OpenAI 호환, Virtual Key 하나로 claude 등 호출) ---
# 실제 LiteLLM 호스트 주소는 팀 내부 문서/시크릿으로 관리하세요(여기엔 자리표시자만).
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=여기에_Virtual_Key
LITELLM_CHAT_MODEL=
LITELLM_VISION_MODEL=
# 프록시에 임베딩 모델이 있으면 그 이름을, 없으면 비워두고 EMBEDDER=openai/gemini 사용
LITELLM_EMBED_MODEL=

# AI 엔진 선택:
#   식단 인식: RECOGNIZER=claude (LiteLLM) | gemini | yolo
#   코치 LLM:  COACH_LLM=litellm | openai | gemini
#   임베딩:    EMBEDDER=openai | gemini | litellm
