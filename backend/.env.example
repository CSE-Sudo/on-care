# cp .env.example .env 후 값 채우기
# 환경: dev | staging | prod   (prod 는 아래 JWT_SECRET 기본값이면 기동이 차단됨)
ENV=dev
#
# 이 파일은 app/core/config.py 의 Settings 와 키가 1:1 이다(tests/test_env_example.py 가 검사).
# 각 키 위 주석의 "기본값" 은 키를 지웠을 때 쓰이는 값, "운영" 은 ENV=prod 권장값이다.
# "# KEY=값" 처럼 주석 처리된 줄은 기본값을 그대로 쓰는 선택 키다 — 바꿀 때만 주석을 푼다.
# 운영 필수 키 목록은 docs/DEPLOY.md 의 환경변수 표를 본다. 비밀값은 운영 비밀 저장소에만 둔다.

# ═══ 개발 전용 — 운영에 그대로 옮기지 말 것 ═══════════════════════════════════
# 앱 기동 시 create_all() 로 테이블 생성(개발 편의). 기본값 true · 운영 false(prod 에서 true 면 기동 차단).
AUTO_CREATE_TABLES=true
# 허용 출처. 기본값 localhost 3곳 · 개발은 flutter run 포트가 매번 달라 '*'.
# 운영: 실제 앱 도메인을 https:// 로 콤마 구분(prod 에서 '*'·기본값 그대로·localhost·http:// 면
# 기동 차단, #3029).
CORS_ALLOW_ORIGINS=*
# 데모 시드(데모 계정·회원 기록·가상 트레이너·가상 헬스장, #2811). 기본값 false 이고
# 로컬 개발에서만 여기서 켠다. 운영(ENV=prod)에서 true 면 기동이 거부된다.
SEED_DEMO_DATA=true
# 데모 계정 로그인 비밀번호. 비워 두면(주석 그대로) 코드의 개발용 기본값을 쓴다.
# DEMO_LOGIN_PASSWORD=
# 헬스장 현장 혜택(PT 재등록 할인·락커 쿠폰·분석용 식판, #2822). 제휴 헬스장이 생기기
# 전까지 false. 데모 시드가 켜진 서버는 이 값과 상관없이 연다. 기본값 false.
GYM_BENEFITS_ENABLED=false
# 토큰이 없거나 만료된 요청을 데모 사용자로 처리(개발 편의). 기본값 true · 운영 false.
# 환경이 prod(ENV=prod)면 이 값과 무관하게 꺼진다. 스테이징·시연 서버를 ENV=dev 로 띄울 때는 반드시 false.
ALLOW_DEMO_FALLBACK=true

# ═══ API ═════════════════════════════════════════════════════════════════════
# 기본값 /v1 · 운영 그대로(앱이 /v1 을 부른다).
# API_V1_PREFIX=/v1
# GET /v1/version·OpenAPI 에 실리는 버전 문자열. 기본값 0.4.0.
# APP_VERSION=0.4.0
# 회원 모바일 앱 최소 지원 버전(#3045). MAJOR.MINOR.PATCH(예: 1.2.0). 이보다 낮은 빌드는
# 업데이트 화면만 보인다. 비우면 검사하지 않는다. 스토어 반영을 확인한 뒤 올린다
# (docs/mobile_release.md). 형식이 틀리면 서버가 뜨지 않는다.
# MIN_MEMBER_APP_VERSION=
# 이미지를 만든 커밋 SHA(#3029). 직접 넣지 않는다 — 배포·CI 가 docker build 의
# build-arg 로 이미지에 넣는다. /v1/version·/v1/healthz 의 commit_sha 와 Sentry release.
# 기본값 unknown.
# GIT_SHA=unknown

# ═══ Database ════════════════════════════════════════════════════════════════
# 운영: 관리형 Postgres(pgvector 필요) URL. postgres:// 로 줘도 psycopg v3 로 정규화된다.
DATABASE_URL=postgresql+psycopg://oncare:oncare@localhost:5432/oncare
# DB 커넥션 풀·쿼리 실행 상한(#2836). (POOL_SIZE + MAX_OVERFLOW) × 워커 수 × 인스턴스 수가
# DB 연결 상한 안에 들어와야 한다(docs/DEPLOY.md). STATEMENT_TIMEOUT_MS=0 이면 상한을 끈다
# — 시작 옵션(options)을 받지 않는 풀러(PgBouncer 등) 엔드포인트를 쓸 때만 끈다.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=10000
# 커넥션 수립 상한(초). 기본값 5.
DB_CONNECT_TIMEOUT_SECONDS=5
# 기동 마이그레이션(scripts/migrate.py — Settings 가 아니라 스크립트가 읽는다, #3034).
# 잠금 대기 한도(초)·잠금 재시도 간격(초)·DB 연결 한도(초). 기본값 120 · 2 · 10.
# MIGRATE_LOCK_TIMEOUT=120
# MIGRATE_LOCK_RETRY_INTERVAL=2
# MIGRATE_CONNECT_TIMEOUT=10

# ═══ 인증(JWT) ═══════════════════════════════════════════════════════════════
# 운영에서는 반드시 교체:  openssl rand -hex 32  (prod 에서 32바이트 미만이면 기동 차단, #3029)
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ALGORITHM=HS256
# 접근 토큰 수명(분, #2913). 앱은 만료되면 refresh 로 이어 간다. 기본값 60.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 리프레시 토큰 수명(일). 기본값 30.
REFRESH_TOKEN_EXPIRE_DAYS=30
# 웹 빌드(X-Client-Platform: web)의 refresh 토큰 수명(일). 기본값 7 (#2828).
WEB_REFRESH_TOKEN_EXPIRE_DAYS=7
# 로그인 한 번이 이어질 수 있는 최대 기간(일, 최초 로그인 기준). 모바일 90·웹 30 (#3086).
SESSION_MAX_DAYS=90
WEB_SESSION_MAX_DAYS=30
# 회전된 refresh 토큰이 이 시간(초) 안에 다시 오면 동시 갱신으로 보고 세션을 끊지 않는다 (#3086).
REFRESH_REUSE_GRACE_SECONDS=30

# --- 소셜 로그인 ---
# Apple 로그인에서 허용할 aud(client_id) 목록, 콤마 구분.
# iOS 앱은 번들 ID, 웹은 Service ID 로 서로 다른 aud 를 받으므로 복수를 넣는다.
#   예: APPLE_CLIENT_IDS=com.oncare.app,com.oncare.web
# 비워두면 Apple 로그인은 검증할 수 없어 **거부**된다(조용히 통과시키면 다른 앱용
# Apple 토큰으로도 로그인이 뚫린다).
APPLE_CLIENT_IDS=
# Google 로그인에서 허용할 id_token aud(OAuth client_id) 목록, 콤마 구분 (#3035).
# Google Cloud 콘솔 > 사용자 인증 정보의 iOS·Android·웹 client_id 를 모두 넣는다.
#   예: GOOGLE_CLIENT_IDS=123-ios.apps.googleusercontent.com,123-web.apps.googleusercontent.com
# 비워두면 Google 로그인은 **거부**된다(aud 를 보지 않으면 다른 앱이 받은 구글 토큰으로도
# 로그인된다).
GOOGLE_CLIENT_IDS=
# 카카오 로그인에서 허용할 앱 ID(카카오 개발자 콘솔 > 앱 설정의 숫자 "앱 ID") (#3035).
# 토큰 정보 조회의 app_id 와 같아야 로그인된다. 아래 KAKAO_REST_API_KEY(장소 검색 키)와 다른
# 값이다. 비워두면 카카오 로그인은 거부된다.
KAKAO_APP_ID=
# 네이버 로그인은 앱이 보낸 토큰의 발급 앱을 확인할 수 없어, 서버 측 코드 교환이 들어올
# 때까지 501 로 닫혀 있다(설정 없음).

# --- 관리자 ---
# 관리자는 환경변수로 정하지 않는다(#3037). `python -m scripts.grant_admin` 으로만 지정한다
# (docs/DEPLOY.md).

# ═══ 업로드·파일 저장소 ══════════════════════════════════════════════════════
# 업로드 요청 본문 상한(바이트). 기본값 10485760(10MiB).
MAX_UPLOAD_BYTES=10485760
# 채팅 첨부 요청 본문의 파일 상한 위 여유(바이트, #2832). multipart 경계·필드 몫이다.
# 기본값 524288(512KiB).
# UPLOAD_BODY_SLACK_BYTES=524288
# 주간 리포트 PDF·채팅 사진 저장 디렉터리(작업 디렉터리 기준 상대 경로 허용).
# 기본값 data/report-pdfs · data/chat-images.
# 운영: 컨테이너를 다시 띄워도 지워지지 않는 영속 저장소 경로로 지정한다(docs/DEPLOY.md).
REPORT_PDF_STORAGE_DIR=data/report-pdfs
CHAT_IMAGE_STORAGE_DIR=data/chat-images
# 파일 한 개 상한(바이트). 기본값 8388608(8MiB) · 6291456(6MiB).
MAX_REPORT_PDF_BYTES=8388608
MAX_CHAT_IMAGE_BYTES=6291456
# 업로드 사진을 펼칠 때의 상한(#3040). 픽셀 수(JPEG 은 축소 디코딩 뒤)와 원본 장변(px).
# 넘으면 디코딩하지 않고 읽을 수 없는 사진으로 거절한다. 기본값 40000000 · 12000.
# MAX_IMAGE_DECODE_PIXELS=40000000
# MAX_IMAGE_DECODE_EDGE=12000
# 채팅 첨부(사진·리포트 PDF) 저장소(#2817). auto 는 버킷이 있으면 S3, 없으면 위 디스크 경로.
# 운영은 S3 버킷 이름을 넣는다(자격 증명은 실행 환경 IAM 역할). docs/DEPLOY.md 참고.
ATTACHMENT_STORAGE=auto
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_PREFIX=chat-attachments
# S3 호환 저장소·로컬 에뮬레이터를 쓸 때만. 비우면 AWS 기본 엔드포인트.
ATTACHMENT_S3_ENDPOINT_URL=

# ═══ AI 엔진(기본: Gemini) ═══════════════════════════════════════════════════
# 키가 비어 있으면 인식·코치·임베딩이 규칙/스텁으로 폴백한다(기동은 된다).
#   식단 인식: RECOGNIZER=gemini | litellm
#   코치 LLM:  COACH_LLM=gemini | openai | litellm
#   임베딩:    EMBEDDER=gemini | openai | litellm
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# 식단 사진 인식 한 건의 대기 한도(초, #2912). 글 생성보다 오래 걸려 따로 둔다.
RECOGNIZER_TIMEOUT_SECONDS=60
# Gemini HTTP 타임아웃(초). 기본값 30.
GEMINI_TIMEOUT_SECONDS=30.0
# LLM 한 번의 출력 토큰 상한(#3032). 호출처는 필요한 길이에 맞춰 더 작게 넘긴다.
# 잘린 JSON 응답은 규칙형 폴백. 0 이면 상한을 넘기지 않는다. 기본값 4096 · 운영 4096.
LLM_MAX_OUTPUT_TOKENS=4096
# 인식 후 공공 식품영양성분 DB 로 영양 수치 보강. 기본값 true · 운영 true(순수 LLM 비교실험 때만 false).
NUTRITION_DB_ENRICH=true
# 참조표에 바로 붙지 않는 운동 이름을 AI 로 종목에 접는다(#1312). 끄면 표 매칭만
# 쓰고, 안 붙는 이름은 유형 평균으로 떨어진다. 키가 없으면 이 값과 무관하게 폴백.
EXERCISE_NAME_AI=true

# --- OpenAI(선택: COACH_LLM=openai 또는 EMBEDDER=openai 일 때만) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- LiteLLM 프록시(선택: RECOGNIZER=litellm·COACH_LLM=litellm·EMBEDDER=litellm 일 때만) ---
# OpenAI 호환 프록시, Virtual Key 하나로 claude 등 호출. 기본 엔진(gemini)만 쓰면 비워 둔다.
# 실제 LiteLLM 호스트 주소·키는 팀 내부 비밀 저장소로 관리한다(여기엔 자리표시자만).
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=
# LITELLM_CHAT_MODEL=claude-sonnet-4-6
# LITELLM_VISION_MODEL=claude-sonnet-4-6
# 프록시에 임베딩 모델이 있으면 그 이름을, 없으면 비워두고 EMBEDDER=gemini/openai 사용
# LITELLM_EMBED_MODEL=

# ═══ RAG ═════════════════════════════════════════════════════════════════════
# 임베딩 차원은 EMBEDDER 모델에 맞춤: Gemini gemini-embedding-001=768 · OpenAI text-embedding-3-small=1536
# 바꾸면 재임베딩 필요(scripts/reembed).
EMBED_DIM=768
CHUNK_WINDOW=5
CHUNK_OVERLAP=1
RETRIEVE_PERSONAL_K=3
RETRIEVE_PUBLIC_K=3
# 식단·운동·채팅 기록 시 회원 개인 문서 자동 적재. 기본값 true · 운영 true.
RAG_AUTO_INGEST=true
# 시드 기록도 개인 문서로 적재(데모 계정 AI 코치용). 기본값 true · 운영 false(데모 시드를 끄면 의미 없음).
SEED_RAG_INGEST=true

# ═══ 장소(O2O) — 카카오 Local 장소검색 (#255) ══════════════════════════════
# developers.kakao.com > 내 애플리케이션 > 앱 키 > "REST API 키"를 붙여넣는다.
# 서버 전용 키 — 프론트로 내보내지 말 것(지도 렌더링은 JavaScript 키를 따로 쓴다).
# 비워두면 places_provider=auto 가 시드 데이터로 폴백한다.
KAKAO_REST_API_KEY=
# auto: 키 있으면 kakao, 없으면 seed. 강제하려면 kakao|seed.
PLACES_PROVIDER=auto
KAKAO_TIMEOUT_SECONDS=3.0

# ═══ 운영 배포 하드닝 ════════════════════════════════════════════════════════
# HTTP→HTTPS 리다이렉트(프록시 뒤면 X-Forwarded-Proto 신뢰). 기본값 false · 운영 true.
FORCE_HTTPS=false
# 보안 응답 헤더(HSTS·nosniff·frame deny 등). 기본값 true · 운영 true.
SECURITY_HEADERS=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL. 기본값 INFO · 운영 INFO.
LOG_LEVEL=INFO
# 로그 타임스탬프용. 도메인 날짜(오늘 식단·오늘/어제 라벨 등)는 이 값에 기대지 않고
# app/core/clock.py 가 KST 로 직접 고정하므로, 비워 둬도 서비스 동작은 같다.
TZ=Asia/Seoul
# rate limit·감사 로그가 믿는 앞단 프록시 수(#2815). X-Forwarded-For 를 오른쪽에서 이 번째
# 값으로 읽는다. 비워 두면 운영(ENV=prod)은 1, 그 밖은 0(소켓 주소). 로컬은 비워 둔다.
# TRUSTED_PROXY_HOPS=
# uvicorn --forwarded-allow-ips(scripts/start.sh). 프록시 대역이 고정이면 그 대역으로 좁힌다.
FORWARDED_ALLOW_IPS=*
# uvicorn 워커 수(scripts/start.sh, #2835). 1 이상의 정수. 기본값 1 — 늘리면 시도 제한과
# DB 연결 수가 워커 수만큼 늘어난다(docs/DEPLOY.md "워커 수와 이벤트 루프").
# WEB_CONCURRENCY=1
# /docs·/redoc·/openapi.json 공개(#2834). 비워 두면 운영(ENV=prod)은 닫고 그 밖은 연다.
# 운영 스키마는 스테이징·로컬에서 본다. 꼭 운영에서 열어야 할 때만 true.
# EXPOSE_API_DOCS=
# 감사 로그(#2830): 같은 트레이너·회원·기록 종류의 열람은 이 분 안에 한 번만 남긴다.
# 보존 기간(일) — 접속 기록 / 건강정보 열람·동의·탈퇴 기록. 0 이면 정리하지 않는다.
# 기본값 10 · 365 · 730.
AUDIT_READ_DEDUPE_MINUTES=10
AUDIT_RETENTION_DAYS=365
AUDIT_SENSITIVE_RETENTION_DAYS=730

# ═══ 에러 추적(Sentry, #2839) ═══════════════════════════════════════════════
# 비워 두면 보내지 않는다. ENV=dev 에서도 값과 무관하게 보내지 않는다.
# 사용자 식별·요청 본문·헤더·쿼리·로그 문구는 싣지 않는다(app/core/error_tracking.py).
SENTRY_DSN=
# 비우면 ENV 값(staging/prod)을 환경 태그로 쓴다.
SENTRY_ENVIRONMENT=
# 오류 이벤트 표본 비율(0.0~1.0). 기본값 1.0. 성능 추적은 쓰지 않는다.
SENTRY_SAMPLE_RATE=1.0

# ═══ Rate limit·비용 한도 ════════════════════════════════════════════════════
# 전체 스위치. false 면 아래 분당·하루 한도(상담 하루 생성 한도 포함)가 모두 꺼진다.
# 기본값 true · 운영 true.
RATE_LIMIT_ENABLED=true
# 인증 엔드포인트 IP·엔드포인트당 분당 시도. 기본값 10.
RATE_LIMIT_AUTH_PER_MINUTE=10
# AI 코치 채팅 분당 한도(회원 IP 버킷·트레이너 id 버킷 공용). 기본값 20.
COACH_CHAT_PER_MINUTE=20
# AI 코치 요청 본문 상한(바이트, 넘으면 413). 회원·트레이너(고객 AI 코칭, #3032) 공용.
# 기본값 262144(256KiB).
COACH_CHAT_MAX_BODY_BYTES=262144
# AI 챗봇 하루 대화 한도(KST 기준). 무료를 다 쓰면 한 번에 PAID_COST 포인트로 PAID_PER_DAY 번까지.
# 기본값 5 · 50 · 10.
COACH_CHAT_FREE_PER_DAY=5
COACH_CHAT_PAID_COST=50
COACH_CHAT_PAID_PER_DAY=10
# 트레이너 AI 루틴 생성 분당 한도. 기본값 10.
ROUTINE_OPTIONS_PER_MINUTE=10
# 식단 사진 분석 호출 한도(#2827). 분당 값은 회원 id 버킷, 하루 값은 KST 날짜로
# DB 에서 센다. 0 이면 그 한도를 끈다. 기본값 10 · 20.
DIET_ANALYZE_PER_MINUTE=10
DIET_ANALYZE_PER_DAY=20
# 하루 AI 호출 상한(#3032). DB 에서 KST 날짜로 세서 인스턴스 수와 무관하다. 0 이면 끔.
#   AI_GLOBAL_CALLS_PER_DAY: 서버 전체(모든 AI 기능 합). 넘으면 폴백 또는 503 ai_capacity.
#     기본값 0(끔) · 운영은 공급자 예산에 맞춰 정한다(DEPLOY.md 3절).
#   TRAINER_AI_CALLS_PER_DAY: 트레이너 한 계정(고객 AI 코치·루틴 후보·리포트 요약 합).
#     넘으면 429 daily_limit. 기본값 200.
AI_GLOBAL_CALLS_PER_DAY=0
TRAINER_AI_CALLS_PER_DAY=200
# 같은 이메일 로그인 연속 실패 잠금: LOGIN_LOCKOUT_SECONDS 안에 LOGIN_MAX_FAILURES 번(#2815).
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# 같은 이메일 가입 시도 시간당 상한(회원·트레이너 공용, #2913).
REGISTER_PER_EMAIL_PER_HOUR=5
# 비밀번호 변경의 현재 비밀번호 연속 실패 잠금(사용자 단위, 창은 LOGIN_LOCKOUT_SECONDS, #2913).
PASSWORD_CHANGE_MAX_FAILURES=5
# 회원 연결 코드 미리보기·사용의 트레이너 하루 상한.
PAIRING_REDEEM_PER_DAY=30

# ═══ 상담 요청 한도 ══════════════════════════════════════════════════════════
# 동시에 답을 기다릴 수 있는 요청 수(넘으면 409 too_many_pending). 0 이면 끔. 기본값 3.
CONSULTATION_MAX_PENDING=3
# 24시간에 만들 수 있는 요청 수(넘으면 429). 0 이면 끔. 기본값 10.
CONSULTATION_CREATE_PER_DAY=10

# ═══ 메일 발송(비밀번호 재설정 #2824 · 가입 인증 #3038 · 이메일 변경 안내 #3039) ═══
# 비워 두면 보내지 않고 서버 로그에만 남긴다(개발용 — 가입 인증 코드도 서버 로그에서
# 읽는다). 운영(ENV=prod)에서 비어 있으면 비밀번호 재설정·가입 인증 코드 요청이 503 으로
# 꺼진다. AWS SES 는 SES SMTP 엔드포인트와 SMTP 자격 증명을 넣는다. 실제 값은 배포
# 환경변수로만 넣는다(이 파일에 적지 않는다). 발송 업체·발신 주소·문의처는 팀이 정할 값이다.
MAIL_PROVIDER=auto
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# SMTP 연결·응답 대기 상한(초). 기본값 10.
SMTP_TIMEOUT_SECONDS=10
# 메일 끝에 적는 문의처(이메일·전화 등). 비우면 문의 줄을 넣지 않는다.
MAIL_SUPPORT_CONTACT=
# 메일 링크가 여는 재설정 화면 주소(비우면 코드만 보낸다). 토큰은 해시 안의 쿼리로
# 붙는다(…#/auth/password-reset?token=…, #3033). 두 앱은 해시 URL 전략·하위 경로 배포라
# 해시형으로 넣는다 — 해시 없는 경로형(https://<도메인>/auth/password-reset)은 앱이 아닌
# 정적 경로를 가리켜 코드가 버려진다. 운영 예:
#   회원 앱      https://<도메인>/frontend/#/auth/password-reset
#   트레이너 웹  https://<도메인>/trainer/#/auth/password-reset
# 로컬은 flutter run 주소에 #/auth/password-reset 을 붙인다. 운영에서 형식이 틀리면 기동 경고.
PASSWORD_RESET_MEMBER_URL=
PASSWORD_RESET_TRAINER_URL=
PASSWORD_RESET_TOKEN_MINUTES=30
# 같은 이메일로 재설정 메일을 보낼 수 있는 횟수/창(분). IP 한도와 별개. 기본값 3 · 15.
PASSWORD_RESET_EMAIL_PER_WINDOW=3
PASSWORD_RESET_EMAIL_WINDOW_MINUTES=15

# ═══ 가입 이메일 인증(#3038) ═════════════════════════════════════════════════
# 회원·트레이너 가입 전에 그 이메일로 보낸 6자리 코드를 확인한다. false 면 코드를 보지
# 않는다(테스트·E2E 전용). 운영(ENV=prod)에서는 false 로 띄울 수 없다. 기본값 true.
SIGNUP_EMAIL_VERIFICATION=true
# 코드 유효 시간(분)·다시 받기 대기(초)·한 코드로 틀릴 수 있는 횟수. 기본값 10 · 60 · 5.
SIGNUP_EMAIL_CODE_MINUTES=10
SIGNUP_EMAIL_CODE_RESEND_SECONDS=60
SIGNUP_EMAIL_CODE_MAX_ATTEMPTS=5
# 같은 이메일로 코드를 보낼 수 있는 횟수/창(분). IP 한도와 별개. 기본값 5 · 60.
SIGNUP_EMAIL_CODE_PER_WINDOW=5
SIGNUP_EMAIL_CODE_WINDOW_MINUTES=60
