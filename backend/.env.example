# cp .env.example .env 후 값 채우기
# 환경: dev | staging | prod   (prod 는 아래 JWT_SECRET 기본값이면 기동이 차단됨)
ENV=dev
#
# 이 파일은 app/core/config.py 의 Settings 와 키가 1:1 이다(tests/test_env_example.py 가 검사).
# 각 키 위 주석의 "기본값" 은 키를 지웠을 때 쓰이는 값, "운영" 은 ENV=prod 권장값이다.
# "# KEY=값" 처럼 주석 처리된 줄은 기본값을 그대로 쓰는 선택 키다 — 바꿀 때만 주석을 푼다.
# 운영 필수 키 목록은 docs/DEPLOY.md 의 환경변수 표를 본다. 비밀값은 운영 비밀 저장소에만 둔다.

# ═══ 개발 전용 — 운영에 그대로 옮기지 말 것 ═══════════════════════════════════
# 앱 기동 시 create_all() 로 테이블 생성(개발 편의). 기본값 true · 운영 false(prod 에서 true 면 기동 차단).
AUTO_CREATE_TABLES=true
# 허용 출처. 기본값 localhost 3곳 · 개발은 flutter run 포트가 매번 달라 '*'.
# 운영: 실제 앱 도메인을 콤마로(prod 에서 '*' 면 기동 차단).
CORS_ALLOW_ORIGINS=*
# 데모 계정·시드 데이터 생성. 기본값 true · 운영 false.
SEED_DEMO_DATA=true
# 데모 계정 로그인 비밀번호. 비워 두면(주석 그대로) 코드의 개발용 기본값을 쓴다.
# 운영에서 SEED_DEMO_DATA=true 로 두려면 기본값이 아닌 12자 이상 값이 필수(아니면 기동 차단).
# DEMO_LOGIN_PASSWORD=
# 토큰이 없거나 만료된 요청을 데모 사용자로 처리(개발 편의). 기본값 true · 운영 false.
# 환경이 prod(ENV=prod)면 이 값과 무관하게 꺼진다. 스테이징·시연 서버를 ENV=dev 로 띄울 때는 반드시 false.
ALLOW_DEMO_FALLBACK=true

# ═══ API ═════════════════════════════════════════════════════════════════════
# 기본값 /v1 · 운영 그대로(앱이 /v1 을 부른다).
# API_V1_PREFIX=/v1
# GET /v1/version·OpenAPI 에 실리는 버전 문자열. 기본값 0.4.0.
# APP_VERSION=0.4.0

# ═══ Database ════════════════════════════════════════════════════════════════
# 운영: 관리형 Postgres(pgvector 필요) URL. postgres:// 로 줘도 psycopg v3 로 정규화된다.
DATABASE_URL=postgresql+psycopg://oncare:oncare@localhost:5432/oncare
# 커넥션 수립 상한(초). 기본값 5.
DB_CONNECT_TIMEOUT_SECONDS=5

# ═══ 인증(JWT) ═══════════════════════════════════════════════════════════════
# 운영에서는 반드시 교체:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ALGORITHM=HS256
# 액세스 토큰 수명(분). 기본값 1440(하루).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 리프레시 토큰 수명(일). 기본값 30.
REFRESH_TOKEN_EXPIRE_DAYS=30
# 웹 빌드(X-Client-Platform: web)의 refresh 토큰 수명(일). 기본값 7 (#2828).
WEB_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 소셜 로그인 ---
# Apple 로그인에서 허용할 aud(client_id) 목록, 콤마 구분.
# iOS 앱은 번들 ID, 웹은 Service ID 로 서로 다른 aud 를 받으므로 복수를 넣는다.
#   예: APPLE_CLIENT_IDS=com.oncare.app,com.oncare.web
# 비워두면 Apple 로그인은 검증할 수 없어 **거부**된다(조용히 통과시키면 다른 앱용
# Apple 토큰으로도 로그인이 뚫린다). kakao/google 은 별도 설정이 필요 없다.
APPLE_CLIENT_IDS=

# --- 관리자 ---
# 기동 시 관리자로 올릴 이메일(콤마 구분). 관리자만 공공 RAG 문서 적재(POST /v1/coach/documents/public)와
# 운영 지표(GET /v1/system/metrics)를 쓸 수 있다. 기본값 비어 있음(관리자 없음) · 운영: 운영 담당자 이메일.
ADMIN_EMAILS=

# ═══ 업로드·파일 저장소 ══════════════════════════════════════════════════════
# 업로드 요청 본문 상한(바이트). 기본값 10485760(10MiB).
MAX_UPLOAD_BYTES=10485760
# 주간 리포트 PDF·채팅 사진 저장 디렉터리(작업 디렉터리 기준 상대 경로 허용).
# 기본값 data/report-pdfs · data/chat-images.
# 운영: 컨테이너를 다시 띄워도 지워지지 않는 영속 저장소 경로로 지정한다(docs/DEPLOY.md).
REPORT_PDF_STORAGE_DIR=data/report-pdfs
CHAT_IMAGE_STORAGE_DIR=data/chat-images
# 파일 한 개 상한(바이트). 기본값 8388608(8MiB) · 6291456(6MiB).
MAX_REPORT_PDF_BYTES=8388608
MAX_CHAT_IMAGE_BYTES=6291456
# 채팅 첨부(사진·리포트 PDF) 저장소(#2817). auto 는 버킷이 있으면 S3, 없으면 위 디스크 경로.
# 운영은 S3 버킷 이름을 넣는다(자격 증명은 실행 환경 IAM 역할). docs/DEPLOY.md 참고.
ATTACHMENT_STORAGE=auto
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_PREFIX=chat-attachments
# S3 호환 저장소·로컬 에뮬레이터를 쓸 때만. 비우면 AWS 기본 엔드포인트.
ATTACHMENT_S3_ENDPOINT_URL=

# ═══ AI 엔진(기본: Gemini) ═══════════════════════════════════════════════════
# 키가 비어 있으면 인식·코치·임베딩이 규칙/스텁으로 폴백한다(기동은 된다).
#   식단 인식: RECOGNIZER=gemini | claude(LiteLLM) | yolo
#   코치 LLM:  COACH_LLM=gemini | openai | litellm
#   임베딩:    EMBEDDER=gemini | openai | litellm
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# 식단 사진 인식 한 건의 대기 한도(초, #2912). 글 생성보다 오래 걸려 따로 둔다.
RECOGNIZER_TIMEOUT_SECONDS=60
# Gemini HTTP 타임아웃(초). 기본값 30.
GEMINI_TIMEOUT_SECONDS=30.0
# 인식 후 공공 식품영양성분 DB 로 영양 수치 보강. 기본값 true · 운영 true(순수 LLM 비교실험 때만 false).
NUTRITION_DB_ENRICH=true
# 참조표에 바로 붙지 않는 운동 이름을 AI 로 종목에 접는다(#1312). 끄면 표 매칭만
# 쓰고, 안 붙는 이름은 유형 평균으로 떨어진다. 키가 없으면 이 값과 무관하게 폴백.
EXERCISE_NAME_AI=true

# --- OpenAI(선택: COACH_LLM=openai 또는 EMBEDDER=openai 일 때만) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- LiteLLM 프록시(선택: RECOGNIZER=claude·COACH_LLM=litellm·EMBEDDER=litellm 일 때만) ---
# OpenAI 호환 프록시, Virtual Key 하나로 claude 등 호출. 기본 엔진(gemini)만 쓰면 비워 둔다.
# 실제 LiteLLM 호스트 주소·키는 팀 내부 비밀 저장소로 관리한다(여기엔 자리표시자만).
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=
# LITELLM_CHAT_MODEL=claude-sonnet-4-6
# LITELLM_VISION_MODEL=claude-sonnet-4-6
# 프록시에 임베딩 모델이 있으면 그 이름을, 없으면 비워두고 EMBEDDER=gemini/openai 사용
# LITELLM_EMBED_MODEL=

# ═══ RAG ═════════════════════════════════════════════════════════════════════
# 임베딩 차원은 EMBEDDER 모델에 맞춤: Gemini gemini-embedding-001=768 · OpenAI text-embedding-3-small=1536
# 바꾸면 재임베딩 필요(scripts/reembed).
EMBED_DIM=768
CHUNK_WINDOW=5
CHUNK_OVERLAP=1
RETRIEVE_PERSONAL_K=3
RETRIEVE_PUBLIC_K=3
# 식단·운동·채팅 기록 시 회원 개인 문서 자동 적재. 기본값 true · 운영 true.
RAG_AUTO_INGEST=true
# 시드 기록도 개인 문서로 적재(데모 계정 AI 코치용). 기본값 true · 운영 false(데모 시드를 끄면 의미 없음).
SEED_RAG_INGEST=true

# ═══ 장소(O2O) — 카카오 Local 장소검색 (#255) ══════════════════════════════
# developers.kakao.com > 내 애플리케이션 > 앱 키 > "REST API 키"를 붙여넣는다.
# 서버 전용 키 — 프론트로 내보내지 말 것(지도 렌더링은 JavaScript 키를 따로 쓴다).
# 비워두면 places_provider=auto 가 시드 데이터로 폴백한다.
KAKAO_REST_API_KEY=
# auto: 키 있으면 kakao, 없으면 seed. 강제하려면 kakao|seed.
PLACES_PROVIDER=auto
KAKAO_TIMEOUT_SECONDS=3.0

# ═══ 운영 배포 하드닝 ════════════════════════════════════════════════════════
# HTTP→HTTPS 리다이렉트(프록시 뒤면 X-Forwarded-Proto 신뢰). 기본값 false · 운영 true.
FORCE_HTTPS=false
# 보안 응답 헤더(HSTS·nosniff·frame deny 등). 기본값 true · 운영 true.
SECURITY_HEADERS=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL. 기본값 INFO · 운영 INFO.
LOG_LEVEL=INFO
# 로그 타임스탬프용. 도메인 날짜(오늘 식단·오늘/어제 라벨 등)는 이 값에 기대지 않고
# app/core/clock.py 가 KST 로 직접 고정하므로, 비워 둬도 서비스 동작은 같다.
TZ=Asia/Seoul
# 감사 로그(#2830): 같은 트레이너·회원·기록 종류의 열람은 이 분 안에 한 번만 남긴다.
# 보존 기간(일) — 접속 기록 / 건강정보 열람·동의·탈퇴 기록. 0 이면 정리하지 않는다.
# 기본값 10 · 365 · 730.
AUDIT_READ_DEDUPE_MINUTES=10
AUDIT_RETENTION_DAYS=365
AUDIT_SENSITIVE_RETENTION_DAYS=730

# ═══ Rate limit·비용 한도 ════════════════════════════════════════════════════
# 전체 스위치. false 면 아래 분당·하루 한도(상담 하루 생성 한도 포함)가 모두 꺼진다.
# 기본값 true · 운영 true.
RATE_LIMIT_ENABLED=true
# 인증 엔드포인트 IP·엔드포인트당 분당 시도. 기본값 10.
RATE_LIMIT_AUTH_PER_MINUTE=10
# AI 코치 채팅 분당 한도(회원 IP 버킷·트레이너 id 버킷 공용). 기본값 20.
COACH_CHAT_PER_MINUTE=20
# 회원 AI 코치 요청 본문 상한(바이트, 넘으면 413). 기본값 262144(256KiB).
COACH_CHAT_MAX_BODY_BYTES=262144
# AI 챗봇 하루 대화 한도(KST 기준). 무료를 다 쓰면 한 번에 PAID_COST 포인트로 PAID_PER_DAY 번까지.
# 기본값 5 · 50 · 10.
COACH_CHAT_FREE_PER_DAY=5
COACH_CHAT_PAID_COST=50
COACH_CHAT_PAID_PER_DAY=10
# 트레이너 AI 루틴 생성 분당 한도. 기본값 10.
ROUTINE_OPTIONS_PER_MINUTE=10

# ═══ 상담 요청 한도 ══════════════════════════════════════════════════════════
# 동시에 답을 기다릴 수 있는 요청 수(넘으면 409 too_many_pending). 0 이면 끔. 기본값 3.
CONSULTATION_MAX_PENDING=3
# 24시간에 만들 수 있는 요청 수(넘으면 429). 0 이면 끔. 기본값 10.
CONSULTATION_CREATE_PER_DAY=10

# ═══ 메일 발송(비밀번호 재설정, #2824) ═══════════════════════════════════════
# 비워 두면 보내지 않고 서버 로그에만 남긴다(개발용). 운영(ENV=prod)에서 비어 있으면
# 비밀번호 재설정 요청이 503 으로 꺼진다. AWS SES 는 SES SMTP 엔드포인트와 SMTP 자격
# 증명을 넣는다. 실제 값은 배포 환경변수로만 넣는다(이 파일에 적지 않는다).
MAIL_PROVIDER=auto
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# SMTP 연결·응답 대기 상한(초). 기본값 10.
SMTP_TIMEOUT_SECONDS=10
# 메일 링크가 여는 재설정 화면 주소(비우면 코드만 보낸다). ?token= 이 붙는다.
PASSWORD_RESET_MEMBER_URL=
PASSWORD_RESET_TRAINER_URL=
PASSWORD_RESET_TOKEN_MINUTES=30
# 같은 이메일로 재설정 메일을 보낼 수 있는 횟수/창(분). IP 한도와 별개. 기본값 3 · 15.
PASSWORD_RESET_EMAIL_PER_WINDOW=3
PASSWORD_RESET_EMAIL_WINDOW_MINUTES=15
