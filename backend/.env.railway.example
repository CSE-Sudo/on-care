# Railway 배포용 환경변수 템플릿 — 예비용(보존)
# ─────────────────────────────────────────────────────────────────────────
# 현재 운영 배포는 AWS ECS Express Mode + Neon 이다(docs/DEPLOY.md). 이 파일은 Railway 로
# 갈아탈 때를 대비해 남겨 둔 예비 템플릿이라, 운영 필수 키의 기준은 아니다.
# 운영 키 목록은 docs/DEPLOY.md "환경변수 / Secrets" 표와 .env.example 의 "운영" 주석을 본다.
# ─────────────────────────────────────────────────────────────────────────
# 사용법: Railway 프로젝트 > 백엔드 서비스 > Variables 탭에 아래 값을 넣는다.
#   · 서비스의 Root Directory 는 반드시 "backend" 로 지정(그래야 railway.json·
#     Dockerfile 을 찾는다).
#   · DB 는 반드시 "pgvector" 템플릿(또는 pgvector 가 설치된 외부 DB: Neon/Supabase)
#     으로 추가한다. Railway 일반 Postgres 이미지에는 pgvector 바이너리가 없어
#     CREATE EXTENSION vector 자체가 실패하므로, 0007 마이그레이션(vector 타입)이
#     동작하지 않는다. (확장 활성화 CREATE EXTENSION IF NOT EXISTS vector; 는
#     pgvector 가 이미 설치된 DB 에서만 가능하다.)
#   · 아래 ${{Postgres.DATABASE_URL}} 은 DB 서비스명이 정확히 "Postgres" 일 때만
#     연결된다. 서비스명을 "Postgres" 로 두거나, 실제 서비스명에 맞춰 참조를 바꾼다
#     (예: pgvector 템플릿이 만든 이름이 다르면 ${{<그 이름>.DATABASE_URL}}).
#   · 이 파일은 예시일 뿐 커밋되는 값이 아니다(실제 시크릿은 Railway 에만 저장).

ENV=prod

# Railway DB 서비스의 참조 변수(서비스명이 "Postgres" 여야 아래가 연결된다).
# 플랫폼은 postgresql://… 형태로 주지만, 앱이 psycopg v3 로 자동 정규화
# (config.sqlalchemy_database_url)하므로 이대로 OK.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# 운영은 Alembic 이 스키마의 정답 → 앱 기동 시 create_all() 비활성.
AUTO_CREATE_TABLES=false

# 반드시 교체:  openssl rand -hex 32  (기본값이면 prod 기동이 차단된다)
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# 프론트(GitHub Pages) 도메인. prod 는 와일드카드('*') 금지.
CORS_ALLOW_ORIGINS=https://ewhasudo.zapto.org

# 오늘/어제 등 날짜 라벨을 KST 기준으로 계산.
TZ=Asia/Seoul

# 운영은 데모 시드를 켤 수 없다(true 면 기동 거부). 기본값도 false 다.
SEED_DEMO_DATA=false
# 헬스장 현장 혜택(PT 재등록 할인·락커 쿠폰·분석용 식판). 제휴 헬스장이 생기기 전까지 false.
GYM_BENEFITS_ENABLED=false
# 토큰 없는 요청을 데모 회원으로 처리하지 않는다(ENV=prod 면 어차피 꺼진다, #2821).
ALLOW_DEMO_FALLBACK=false

# AI — 운영에서는 필수. 인식(RECOGNIZER)·임베딩(EMBEDDER)에 맞는 키가 비어 있으면
# 기동이 거부된다(#2812). 키 없이 쓰는 고정 식단 스텁(stub)·해시 임베딩(hash)은
# 개발·테스트 전용이고 운영에서는 지정해도 거부된다.
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 임베딩 차원(Gemini gemini-embedding-001 = 768)
EMBED_DIM=768

# 장소(O2O) 실검색 — 없으면 시드 폴백.
KAKAO_REST_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# 참고: PORT 는 Railway 가 자동 주입한다. 직접 설정하지 말 것
#       (start.sh 가 ${PORT:-8000} 로 바인딩한다).
