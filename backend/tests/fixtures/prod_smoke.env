# 운영 설정(ENV=prod) 기동 스모크용 더미 값(#3163). 실제 비밀이 아니다.
#
# 백엔드 CI 의 `Docker image build + boot smoke` 잡이 `docker run --env-file` 로 넣어
# 운영 기동 가드(app/core/config.py `_guard_prod_secrets`, app/core/startup_checks.py)를
# 통과하는지 본다. tests/test_prod_smoke_env.py 가 같은 값으로 가드를 직접 불러 확인하므로,
# 가드가 늘어나면 여기 값을 함께 더한다. 운영 실제 값의 원본은 infra/backend-service.yml 이다.
#
# 외부로 나가는 호출이 생기지 않게 한다 — S3·SMTP·Gemini 주소는 쓰이지 않고(기동 때 연결하지
# 않음), 공공 코칭 문서 임베딩만 더미 키로 한 번 실패하고 넘어간다(best-effort).
ENV=prod
# 풀러(-pooler)가 아닌 직접 연결 주소. 컨테이너가 --network host 로 CI 의 Postgres 서비스에 붙는다.
DATABASE_URL=postgresql+psycopg://oncare:oncare@localhost:5432/oncare
JWT_SECRET=ci-prod-smoke-dummy-jwt-secret-0123456789abcdef
CORS_ALLOW_ORIGINS=https://app.oncare-ci-smoke.com,https://trainer.oncare-ci-smoke.com
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=false
SEED_RAG_INGEST=false
SIGNUP_EMAIL_VERIFICATION=true
ALLOW_DEMO_FALLBACK=false
FORCE_HTTPS=true
TRUSTED_PROXY_HOPS=1
WEB_CONCURRENCY=1
TZ=Asia/Seoul
LOG_LEVEL=INFO
RECOGNIZER=gemini
COACH_LLM=gemini
EMBEDDER=gemini
EMBED_DIM=768
GEMINI_API_KEY=ci-dummy-gemini-key
GEMINI_TIMEOUT_SECONDS=5
ATTACHMENT_STORAGE=s3
ATTACHMENT_S3_BUCKET=oncare-ci-smoke-dummy-attachments
ATTACHMENT_S3_REGION=ap-northeast-2
ATTACHMENT_S3_PREFIX=chat-attachments
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@oncare-ci-smoke.com
SMTP_HOST=smtp.oncare-ci-smoke.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=ci-smoke-dummy-user
SMTP_PASSWORD=ci-smoke-dummy-password
PASSWORD_RESET_MEMBER_URL=https://app.oncare-ci-smoke.com/frontend/#/auth/password-reset
PASSWORD_RESET_TRAINER_URL=https://trainer.oncare-ci-smoke.com/trainer/#/auth/password-reset
