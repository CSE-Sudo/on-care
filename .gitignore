.env
.venv/

# Python
__pycache__/
*.py[cod]

# OS / editor cruft
.DS_Store
*.swp

# JetBrains IDE settings — every nested .idea dir
.idea/

# Claude Code / Cowork tooling (per-session launch configs, etc.)
.claude/

# Node tooling — guard against any future Node-based add-on.
node_modules/
package-lock.json

# Flutter golden test diff outputs (regenerated locally on failure).
# 골든이 어긋나면 비교 대상 파일 옆 `failures/` 에 기준·실제·차이 PNG 가 생긴다(#2054).
**/test/golden/failures/
**/test/failures/

# 공공 표준데이터 원본 CSV(5.9MB) — 집계본만 커밋한다
backend/data/raw/

# 공공 운동 MET 집계본 — 원본이 KOGL 제4유형(상업적 이용금지·변경금지)이라
# 식단 집계본과 달리 산출본도 커밋하지 않는다. 받는 경로는
